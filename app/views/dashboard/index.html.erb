<h1>Welcome, <%= current_user.first_name %>!</h1>

<h2>Your Favorite Garden</h2>
<% if @favorite_garden %>
<h3>Click on a Garden Plot to update it </h3>
  <%= render partial: "gardens/grid", locals: { garden: @favorite_garden, plots: @garden_plots } %>
<% else %>
  <p>You don’t have any gardens yet. <%= link_to "Create your first garden", new_garden_path %></p>
<% end %>

<h3>All Your Gardens</h3>
<ul style="list-style: none; padding-left: 0;">
  <% @gardens.each do |garden| %>
    <li>
      <%= link_to garden.name, garden_path(garden) %>
      <% if garden.favorite? %>⭐<% end %>
    </li>
  <% end %>
</ul>
