<div data-controller="plant-modal">
  <dialog data-plant-modal-target="dialog">
    <article>
      <header>
        <button type="button" data-action="plant-modal#close">✕</button>
        <h3>Sow a Seed</h3>
      </header>

      <form data-action="submit->plant-modal#sowSeed">
        <input type="hidden" data-plant-modal-target="plotId">
        <input type="hidden" data-plant-modal-target="plantId">

        <input type="text"
               placeholder="Search plants..."
               data-plant-modal-target="plantInput"
               data-action="input->plant-modal#search">
        <div data-plant-modal-target="results" class="autocomplete-dropdown"></div>

        <footer>
          <button type="button" data-action="plant-modal#close">Cancel</button>
          <button type="submit">Sow Seed</button>
        </footer>
      </form>
    </article>
  </dialog>
</div>
