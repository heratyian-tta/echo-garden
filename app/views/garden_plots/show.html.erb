
    <% if @plant.present? %>
         <h1><%= @plant.common_name %></h1>
    <h2><%= @plant.scientific_name %></h2>
    <img src="<%= @plant.image_url %>" alt="<%= @plant.common_name %>" style="max-width: 100%; height: auto;" />
    <p><%= @plant.description %></p>
    <% else %>
      <p>No plant selected.</p>

      <%= button_to "Choose a Plant", plants_path(garden_plot_id: @garden_plot.id), method: :get, class: "btn btn-primary" %>
    <% end %>
   

<button action="<%= edit_garden_plot_path(@garden_plot.id) %>">Update my plot</button>
